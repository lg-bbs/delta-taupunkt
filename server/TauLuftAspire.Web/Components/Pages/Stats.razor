@page "/stats"
@inject MeasurementApiClient MeasurementApiClient
@using MudBlazor
@using TauLuftAspire.Model.Entity
@using TauLuftAspire.Web.ApiClient
@using TauLuftAspire.Web.Components.Default

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="width-100">
        <MudText Typo="Typo.h4" Class="mb-6">Auswertungen</MudText>
        <DateSpanSelectButton @bind-DateRange="_dateRange" OnUpdate="Update" Class="mb-8" />
    </MudStack>

    <MudGrid>
        <MudItem xs="12" lg="6">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Taupunkt Vergleich (°C)</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudChart ChartType="ChartType.Line"
                              ChartSeries="@_tpSeries"
                              XAxisLabels="@_xAxisLabels"
                              Width="100%" Height="300px"
                              ChartOptions="@_tpOptions" />
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" lg="6">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Temp (°C) & Feuchte (%)</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudChart ChartType="ChartType.Line"
                              ChartSeries="@_thSeries"
                              XAxisLabels="@_xAxisLabels"
                              Width="100%" Height="300px"
                              ChartOptions="@_thOptions" />
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<Measurement> _measurements = new();

    private DateRange _dateRange = new DateRange(DateTime.Now.Date.AddDays(-2), DateTime.Now.Date);

    private List<ChartSeries> _tpSeries = new();
    private List<ChartSeries> _thSeries = new();
    private string[] _xAxisLabels = Array.Empty<string>();
    private ChartOptions _options = new() { InterpolationOption = InterpolationOption.NaturalSpline };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await Update();
    }

    private async Task Update()
    {
        DateTime start = new DateTime(DateOnly.FromDateTime(_dateRange.Start.Value), new TimeOnly(0, 0, 0));
        DateTime end = new DateTime(DateOnly.FromDateTime(_dateRange.End.Value), new TimeOnly(23, 59, 59));
        _measurements = await MeasurementApiClient.GetMeasurementsAsync(start, end);
        PrepareCharts();
    }

    private string[] _tpPalette = { "#FF5252", "#448AFF" };
    private string[] _thPalette = { "#FF5252", "#5294ff", "#802a2a", "#27477a" };

    private ChartOptions _tpOptions = new() { InterpolationOption = InterpolationOption.NaturalSpline };
    private ChartOptions _thOptions = new() { InterpolationOption = InterpolationOption.NaturalSpline };

    private void PrepareCharts()
    {
        if (!_measurements.Any()) return;

        int totalPoints = _measurements.Count;
        int labelInterval = Math.Max(1, totalPoints / 6);

        _xAxisLabels = new string[totalPoints];
        for (int i = 0; i < totalPoints; i++)
        {
            if (i % labelInterval == 0)
            {
                _xAxisLabels[i] = _measurements[i].LocalTimestamp.ToString("dd.MM HH:mm");
            }
            else
            {
                _xAxisLabels[i] = "";
            }
        }

        _tpOptions.ChartPalette = _tpPalette;
        _thOptions.ChartPalette = _thPalette;

        _tpSeries = new List<ChartSeries>
        {
            new ChartSeries { Name = "TP Innen", Data = _measurements.Select(m => m.Inside.DewPoint).ToArray() },
            new ChartSeries { Name = "TP Außen", Data = _measurements.Select(m => m.Outside.DewPoint).ToArray() }
        };

        _thSeries = new List<ChartSeries>
        {
            new ChartSeries { Name = "Temp Innen", Data = _measurements.Select(m => m.Inside.Temperature).ToArray() },
            new ChartSeries { Name = "Hum Innen", Data = _measurements.Select(m => m.Inside.Humidity).ToArray() },
            new ChartSeries { Name = "Temp Außen", Data = _measurements.Select(m => m.Outside.Temperature).ToArray() },
            new ChartSeries { Name = "Hum Außen", Data = _measurements.Select(m => m.Outside.Humidity).ToArray() }
        };
    }
}