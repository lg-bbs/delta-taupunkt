@page "/logs"
@inject IDialogService DialogService
@inject LogApiClient LogApiClient
@using Model.Entity
@using Model.Enum
@using MudBlazor
@using TauLuftAspire.Web.ApiClient
@using TauLuftAspire.Web.Components.Default
@using TauLuftAspire.Web.Components.Extensions
@using TauLuftAspire.Web.Components.Layout

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
    @* Header Bereich *@
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="width-100">
        <MudText Typo="Typo.h4">Meldungen</MudText>
        <div class="d-flex">
            <MudSelect T="int" Label="Angezeigter Schweregrad" Variant="Variant.Outlined" Value="@minLevelPriority" ValueChanged="OnLevelChanged" Class="mr-3" Style="max-width: 250px; min-width: 250px" Dense="true">
                <MudSelectItem Value="1">Debug</MudSelectItem>
                <MudSelectItem Value="2">Standard</MudSelectItem>
                <MudSelectItem Value="3">Info</MudSelectItem>
                <MudSelectItem Value="4">Warnungen</MudSelectItem>
                <MudSelectItem Value="5">Fehler</MudSelectItem>
            </MudSelect>
            <DateSpanSelectButton @bind-DateRange="_dateRange" OnUpdate="Update" MaxDays="10" Class="mr-3" Style="height: fit-content; align-self: center" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Update" StartIcon="@Icons.Material.Filled.Refresh" Style="height: fit-content; align-self: center">Aktualisieren</MudButton>
        </div>
    </MudStack>

    <MudTable Items="@Logs" Hover="true" Dense="true" FixedHeader="true"
              Filter="new Func<LogEntry, bool>(FilterSearch)" SortLabel="Sortieren" RowsPerPage="25" GroupBy="@_groupDefinition" Loading="@IsLoading">

        <ToolBarContent>
            <MudTextField @bind-Value="searchString" Placeholder="Suche in Meldungen..." Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>

        <HeaderContent>
            <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<LogEntry, object>(x => x.LocalTimestamp)">Zeit</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<LogEntry, object>(x => GetLevelPriority(x.Severity))">Level</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<LogEntry, object>(x => x.Source)">Quelle</MudTableSortLabel></MudTh>
            <MudTh>Meldung</MudTh>
            <MudTh Style="text-align:right">Aktionen</MudTh>
        </HeaderContent>

        <GroupHeaderTemplate>
            <MudTh Class="mud-theme-dark pa-2" colspan="5" Style="background-color: var(--mud-palette-background-grey);">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="mr-2" />
                    <MudText Typo="Typo.subtitle2">
                        @(((DateTime)context.Key).ToString("dd. MMMM yyyy"))
                    </MudText>
                </div>
            </MudTh>
        </GroupHeaderTemplate>

        <RowTemplate>
            <MudTd>@context.LocalTimestamp.ToString("HH:mm:ss")</MudTd>
            <MudTd>
                <MudChip T="string" Color="context.Severity.MudColor"
                         Icon="@context.Severity.MudIcon"
                         Size="Size.Small" Variant="Variant.Filled">
                    @context.Severity.ToString()
                </MudChip>
            </MudTd>
            <MudTd>@context.Source</MudTd>
            <MudTd>
                <div style="max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    @context.Message
                </div>
            </MudTd>
            <MudTd Style="text-align:right">
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           OnClick="@(() => OpenDetailDialog(context))"
                           StartIcon="@Icons.Material.Filled.ZoomIn">Details</MudButton>
            </MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudContainer>

<style>
    .h-40 {
        height: 40px !important;
    }
</style>

@code {
    [CascadingParameter] public required MainLayout MainLayout { get; set; }

    private TableGroupDefinition<LogEntry> _groupDefinition = new()
    {
        GroupName = "Datum",
        Indentation = false,
        Expandable = false,
        Selector = (e) => e.LocalTimestamp.Date
    };

    private DateRange _dateRange = new DateRange(DateTime.Now.Date.AddDays(-1), DateTime.Now.Date);

    private string searchString = "";
    private int minLevelPriority = 2; // Standard: Info (zeigt alles)
    private List<LogEntry> Logs = new();
    private bool IsLoading = true;

    private async Task OnLevelChanged(int newPriority) 
    {
        minLevelPriority = newPriority;
        await Update();
    }

    private bool FilterSearch(LogEntry element)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        return element.Message?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true ||
               element.Source?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true;
    }

    private int GetLevelPriority(LogSeverity severity) => ((int)severity);

    private void OpenDetailDialog(LogEntry entry)
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        DialogService.ShowMessageBox("Log-Details", $"{entry.Message}\n\n{entry.Details}", options: options);
    }

    protected override async Task OnInitializedAsync()
    {
        await Update();
    }

    private async Task Update()
    {
        IsLoading = true;

        DateTime start = new DateTime(DateOnly.FromDateTime(_dateRange.Start.Value), new TimeOnly(0, 0, 0));
        DateTime end = new DateTime(DateOnly.FromDateTime(_dateRange.End.Value), new TimeOnly(23, 59, 59));

        Logs = await LogApiClient.GetAllLogsAsync(start, end, minLevelPriority);
        await LogApiClient.PostAllReadAsync();

        await MainLayout.MarkNoUnreadLogsAsync();

        IsLoading = false;
    }
}