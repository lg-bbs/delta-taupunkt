@page "/raw"
@inject MeasurementApiClient MeasurementApiClient
@using MudBlazor
@using TauLuftAspire.Model.Entity
@using TauLuftAspire.Web.ApiClient
@using TauLuftAspire.Web.Components.Default

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudText Typo="Typo.h4" Class="mb-6">Rohdaten</MudText>

    <DateSpanSelectButton @bind-DateRange="_dateRange" OnUpdate="Update" />

    <MudGrid>
        @* <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 mb-4">
                <MudDateRangePicker Label="Zeitraum auswählen" @bind-DateRange="_dateRange"
                                    AutoClose="true" PickerVariant="PickerVariant.Dialog"
                                    Margin="Margin.Dense" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Update" Class="ml-auto">
                Daten filtern
            </MudButton>
        </MudItem> *@

        

        <MudItem xs="12">
            <MudTable Items="@_measurements" Dense="true" Hover="true" Elevation="2" RowsPerPage="50" GroupBy="@_groupDefinition">
                <ColGroup>
                    <col />
                    <col style="width: 10%;" />
                    <col style="width: 10%;" />
                    <col style="width: 10%;" />
                    <col style="width: 10%;" />
                    <col style="width: 10%;" />
                    <col style="width: 10%;" />
                    <col />
                    <col />
                </ColGroup>
                <HeaderContent>
                    <MudTh>Zeitpunkt</MudTh>
                    <MudTh Class="bg-indoor">Innen °C</MudTh>
                    <MudTh Class="bg-indoor">Innen %</MudTh>
                    <MudTh Class="bg-indoor border-right">Innen TP</MudTh>
                    <MudTh Class="bg-outdoor">Außen °C</MudTh>
                    <MudTh Class="bg-outdoor">Außen %</MudTh>
                    <MudTh Class="bg-outdoor">Außen TP</MudTh>
                    <MudTh>Delta TP</MudTh>
                    <MudTh>Lüfter-Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.LocalTimestamp.ToString("HH:mm 'Uhr'")</MudTd>
                    <MudTd Class="bg-indoor">@context.Inside.Temperature°C</MudTd>
                    <MudTd Class="bg-indoor">@context.Inside.Humidity%</MudTd>
                    <MudTd Class="bg-indoor border-right"><b>@context.Inside.DewPoint°C</b></MudTd>
                    <MudTd Class="bg-outdoor">@context.Outside.Temperature°C</MudTd>
                    <MudTd Class="bg-outdoor">@context.Outside.Humidity%</MudTd>
                    <MudTd Class="bg-outdoor"><b>@context.Outside.DewPoint°C</b></MudTd>
                    <MudTd>@((context.Inside.DewPoint - context.Outside.DewPoint).ToString("N1")) K</MudTd>
                    <MudTd><MudIcon Icon="@(context.IsFanRunning ? Icons.Material.Filled.Air : Icons.Material.Filled.Block)" Color="@(context.IsFanRunning ? Color.Success : Color.Error)" /></MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager AllItemsText="Alle" PageSizeOptions="new int[] {20, 50, 100, int.MaxValue}" />
                </PagerContent>
                <GroupHeaderTemplate>
                    <MudTh Class="mud-theme-dark pa-2" colspan="9" Style="background-color: var(--mud-palette-background-grey);">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="mr-2" />
                            <MudText Typo="Typo.subtitle2">
                                @(((DateTime)context.Key).ToString("dd. MMMM yyyy"))
                            </MudText>
                        </div>
                    </MudTh>
                </GroupHeaderTemplate>
            </MudTable>
        </MudItem>
    </MudGrid>
</MudContainer>

<style>
    .border-right {
        border-right: 2px solid var(--mud-palette-divider) !important;
    }

    .bg-indoor {
        background-color: rgba(255, 152, 0, 0.05);
    }

    .bg-outdoor {
        background-color: rgba(33, 150, 243, 0.05);
    }
</style>

@code {
    private List<Measurement> _measurements = new();

    private TableGroupDefinition<Measurement> _groupDefinition = new()
    {
        GroupName = "Datum",
        Indentation = false,
        Expandable = false,
        Selector = (e) => e.LocalTimestamp.Date
    };
   
    private DateRange _dateRange = new DateRange(DateTime.Now.Date.AddDays(-2), DateTime.Now.Date);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await Update();
    }

    private async Task Update()
    {
        DateTime start = new DateTime(DateOnly.FromDateTime(_dateRange.Start.Value), new TimeOnly(0, 0, 0));
        DateTime end = new DateTime(DateOnly.FromDateTime(_dateRange.End.Value), new TimeOnly(23, 59, 59));
        _measurements = await MeasurementApiClient.GetMeasurementsAsync(start, end);
    }
}