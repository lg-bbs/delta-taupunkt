@page "/settings"
@using MudBlazor
@using TauLuftAspire.Model.Entity
@using TauLuftAspire.Web.ApiClient
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject LogApiClient LogApiClient
@inject MeasurementApiClient MeasurementApiClient
@inject ConfigApiClient ConfigApiClient

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8 px-6">
    <MudText Typo="Typo.h4" Class="mb-6 font-weight-bold">Systemkonfiguration</MudText>

    <MudTabs Elevation="4" Rounded="true" Color="Color.Primary" ApplyEffectsToContainer="true" PanelClass="pa-6">

        @* --- TAB 1: REGELUNGSLOGIK --- *@
        <MudTabPanel Text="Regelung" Icon="@Icons.Material.Filled.Tune">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.h6" Class="mb-4">Schwellenwerte</MudText>
                    <MudStack Spacing="4">
                        <MudNumericField @bind-Value="DewPointDelta" Label="Einschalt-Differenz (ΔTP)" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentText="K" HelperText="Mindestdifferenz zwischen Innen- und Außentaupunkt" />
                        <MudNumericField @bind-Value="Hysteresis" Label="Hysterese" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentText="K" HelperText="Zusätzliches ΔTP, welches zum Einschalten benötigt wird (bewirkt, dass Lüfter an Grenztemperaturen nicht mehrfach aktiviert und deaktiviert wird)" />
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.h6" Class="mb-4">Grenzwerte</MudText>
                    <MudStack Spacing="4">
                        <MudNumericField @bind-Value="MinOutdoorTemp" Label="Minimale Außentemperatur" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentText="°C" HelperText="Ist die Außentemperatur geringer, wird die Lüftung deaktiviert" />
                        <MudNumericField @bind-Value="MinIndoorTemp" Label="Minimale Innentemperatur" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentText="°C" HelperText="Ist die Innentemperatur geringer, wird die Lüftung deaktiviert" />
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.h6" Class="mb-4">Intervalle</MudText>
                    <MudNumericField @bind-Value="MeasureInterval" Label="Mess-Intervalle" Variant="Variant.Outlined" Step="1" Adornment="Adornment.End" AdornmentText="Sekunden" />
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Kalibrierung" Icon="@Icons.Material.Filled.Build">
            <MudGrid>
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Class="mb-4">Kalibrierungsdaten direkt auf die Sensorwerte als Offsets anwenden.</MudAlert>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle1">Sensor Innen</MudText>
                    <div class="d-flex gap-4">
                        <MudNumericField @bind-Value="InTempOffset" Label="Offset Temp (°C)" Variant="Variant.Outlined" Step="0.1" Adornment="Adornment.End" AdornmentText="°C" />
                        <MudNumericField @bind-Value="InHumOffset" Label="Offset Feuchte (%)" Variant="Variant.Outlined" Step="0.1" Adornment="Adornment.End" AdornmentText="%" />
                    </div>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle1">Sensor Außen</MudText>
                    <div class="d-flex gap-4">
                        <MudNumericField @bind-Value="OutTempOffset" Label="Offset Temp (°C)" Variant="Variant.Outlined" Step="0.1" Adornment="Adornment.End" AdornmentText="°C" />
                        <MudNumericField @bind-Value="OutHumOffset" Label="Offset Feuchte (%)" Variant="Variant.Outlined" Step="0.1" Adornment="Adornment.End" AdornmentText="%" />
                    </div>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Zeitplan" Icon="@Icons.Material.Filled.HistoryToggleOff">
            <MudAlert Severity="Severity.Info" Class="mb-4" Variant="Variant.Outlined">
                Klicke auf die Stundenblöcke, um feste Betriebszeiten zu erzwingen.
                <br />
                <span style="font-weight:bold">Grau: Automatik</span> |
                <span style="font-weight:bold">Grün: Bevorzugt AN</span> |
                <span style="font-weight:bold">Rot: Bevorzugt AUS</span>
            </MudAlert>

            <MudPaper Elevation="0" Class="pa-4 bg-transparent">
                @foreach (var day in Enum.GetValues<DayOfWeek>().OrderBy(d => (int)d == 0 ? 7 : (int)d))
                {
                    <div class="mb-5">
                        <div class="d-flex justify-space-between align-center mb-1">
                            <MudText Typo="Typo.subtitle2" Inline="true" Class="font-weight-bold">@GetDayName(day)</MudText>

                            @* Button-Leiste für den Tag *@
                            <div class="d-flex gap-1">
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                               OnClick="() => CopyDay(day)" Title="Tag kopieren" Color="Color.Default" />

                                <MudIconButton Icon="@Icons.Material.Filled.ContentPaste" Size="Size.Small"
                                               OnClick="() => PasteDay(day)" Title="Einfügen"
                                               Color="Color.Primary" Disabled="@(Clipboard == null)" />

                                <MudIconButton Icon="@Icons.Material.Filled.RestartAlt" Size="Size.Small"
                                               OnClick="() => ResetDay(day)" Title="Zurücksetzen" Color="Color.Error" />
                            </div>
                        </div>
                        <div class="d-flex w-100" style="height: 40px; border: 1px solid var(--mud-palette-lines-default); border-radius: 6px; overflow: hidden; background: #f5f5f5;">
                            @for (int hour = 0; hour < 24; hour++)
                            {
                                var currentHour = hour;
                                var currentDay = day;
                                <div @onclick="() => ToggleHourState(currentDay, currentHour)"
                                     style="flex: 1;
                                            cursor: pointer;
                                            background-color: @GetColorForState(currentDay, currentHour);
                                            border-right: 1px solid rgba(0,0,0,0.08);
                                            transition: all 0.1s ease;"
                                     title="@hour:00 Uhr: @(GetStateName(currentDay, currentHour))">
                                </div>
                            }
                        </div>
                        <div class="d-flex justify-space-between px-1">
                            <MudText Typo="Typo.caption" Style="font-size: 0.65rem">00:00</MudText>
                            <MudText Typo="Typo.caption" Style="font-size: 0.65rem">06:00</MudText>
                            <MudText Typo="Typo.caption" Style="font-size: 0.65rem">12:00</MudText>
                            <MudText Typo="Typo.caption" Style="font-size: 0.65rem">18:00</MudText>
                            <MudText Typo="Typo.caption" Style="font-size: 0.65rem">23:00</MudText>
                        </div>
                    </div>
                }
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="Debug" Icon="@Icons.Material.Filled.BugReport">
            <MudGrid>
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Error" Icon="@Icons.Material.Filled.Warning" Class="mb-4">
                        Diese Funktionen sind nur zum Testen gedacht
                    </MudAlert>
                </MudItem>
                <MudItem>
                    <MudButton Variant="Variant.Outlined" OnClick="DebugInsertTestLogs">Test-Logs einfügen</MudButton>
                </MudItem>
                <MudItem>
                    <MudButton Variant="Variant.Outlined" OnClick="DebugInsertTestMeasurements">Test-Messwerte einfügen</MudButton>
                </MudItem>
                <MudItem>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DebugDeleteAllLogs">Alle Logs löschen</MudButton>
                </MudItem>
                <MudItem>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DebugDeleteAllMeasurements">Alle Messwerte löschen</MudButton>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
    </MudTabs>

    <div class="d-flex justify-end gap-4 mt-6">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Save" OnClick="Save">Konfiguration Speichern</MudButton>
    </div>
</MudContainer>

@code {
    // Regelung
    private double DewPointDelta = 0;
    private double Hysteresis = 0;
    private double MinIndoorTemp = 0;
    private double MinOutdoorTemp = 0;
    private int MeasureInterval = 0;

    // Kalibrierung
    private double InTempOffset = 0;
    private double InHumOffset = 0;
    private double OutTempOffset = 0;
    private double OutHumOffset = 0;

    private Dictionary<DayOfWeek, int[]> WeeklySchedule = new();
    private int[]? Clipboard = null;

    protected override async Task OnInitializedAsync()
    {
        var config = await ConfigApiClient.GetConfigAsync();
        DewPointDelta = config.TargetDelta;
        Hysteresis = config.Hysrerese;
        MinIndoorTemp = config.MinTempInside;
        MinOutdoorTemp = config.MinTempOutside;
        MeasureInterval = config.Interval;
        InTempOffset = config.TempInsideOffset;
        InHumOffset = config.HumInsideOffset;
        OutTempOffset = config.TempOutsideOffset;
        OutHumOffset = config.HumOutsideOffset;
    }

    private async void Save()
    {
        var newConfig = new Config
        {
            TargetDelta = DewPointDelta,
            Hysrerese = Hysteresis,
            MinTempInside = MinIndoorTemp,
            MinTempOutside = MinOutdoorTemp,
            Interval = MeasureInterval,
            TempInsideOffset = InTempOffset,
            HumInsideOffset = InHumOffset,
            TempOutsideOffset = OutTempOffset,
            HumOutsideOffset = OutHumOffset
        };
        await ConfigApiClient.PostConfigAsync(newConfig);
        Snackbar.Add("Einstellungen wurden erfolgreich gespeichert!", Severity.Success);
        await JSRuntime.InvokeVoidAsync("window.scrollTo", new { top = 0, behavior = "smooth" });
    }

    protected override void OnInitialized()
    {
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomLeft;
        Snackbar.Configuration.VisibleStateDuration = 2000;
        Snackbar.Configuration.ShowTransitionDuration = 250;
        Snackbar.Configuration.HideTransitionDuration = 500;
        foreach (DayOfWeek day in Enum.GetValues(typeof(DayOfWeek)))
        {
            WeeklySchedule[day] = new int[24];
        }
    }

    private void ToggleHourState(DayOfWeek day, int hour)
    {
        WeeklySchedule[day][hour] = (WeeklySchedule[day][hour] + 1) % 3;
    }


    private void CopyDay(DayOfWeek day)
    {
        Clipboard = (int[])WeeklySchedule[day].Clone();
    }

    private void PasteDay(DayOfWeek day)
    {
        if (Clipboard != null)
        {
            WeeklySchedule[day] = (int[])Clipboard.Clone();
        }
    }

    private void ResetDay(DayOfWeek day)
    {
        WeeklySchedule[day] = new int[24];
    }

    private string GetColorForState(DayOfWeek day, int hour) => WeeklySchedule[day][hour] switch
    {
        1 => "var(--mud-palette-success)", // Grün
        2 => "var(--mud-palette-error)",   // Rot
        3 => "var(--mud-palette-info)",    // Blau
        _ => "transparent"                 // Automatik
    };

    private string GetStateName(DayOfWeek day, int hour) => WeeklySchedule[day][hour] switch
    {
        1 => "Dauerbetrieb",
        2 => "Sperrzeit",
        3 => "Flüstermodus",
        _ => "Automatik"
    };

    private string GetDayName(DayOfWeek day) => System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName(day);

    private async Task DebugInsertTestLogs()
    {
        await LogApiClient.PostInsertTestLogs();
        Snackbar.Add("Test-Logs wurden eingefügt!", Severity.Success);
    }

    private async Task DebugInsertTestMeasurements()
    {
        await MeasurementApiClient.PostInsertTestMeasurementsAsync();
        Snackbar.Add("Test-Messwerte wurden eingefügt!", Severity.Success);
    }

    private async Task DebugDeleteAllMeasurements()
    {
        await MeasurementApiClient.DeleteAll();
        Snackbar.Add("Alle Messwerte wurden gelöscht!", Severity.Success);
    }

    private async Task DebugDeleteAllLogs()
    {
        await LogApiClient.DeleteAll();
        Snackbar.Add("Alle Logs wurden gelöscht!", Severity.Success);
    }
}